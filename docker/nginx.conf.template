server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # single-page app: unknown paths fall back to index.html (React Router handles them)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # hashed build assets can be cached for a long time
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
